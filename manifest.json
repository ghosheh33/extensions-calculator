{
  "manifest_version": 3,
  "name": "الآلة الحاسبة",
  "version": "2.0",
  "description": "آلة حاسبة علمية ذكية مع ميزات النسخ السريع، سجل العمليات، وحساب النصوص المظللة.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "افتح الآلة الحاسبة"
  },
  "permissions": [
    "contextMenus",
    "storage"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ],
  "icons": {
    "16": "Icons/icon16.png",
    "48": "Icons/icon48.png",
    "128": "Icons/icon128.png"
  }
}